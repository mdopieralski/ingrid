{
  // Type-checks everything (src, test, scripts); emits nothing. `pnpm build` uses tsconfig.build.json.
  "compilerOptions": {
    // Node 22
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // The same files run directly in Node (type stripping) and compiled (tsc):
    // only syntax Node can erase, type-only imports marked as such, and `.ts`
    // import paths that tsc rewrites to `.js` when it emits.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts"]
}
