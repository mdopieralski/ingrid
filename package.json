{
  "name": "ingrid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "cache:clean": "rm -rf node_modules && echo 'Caches cleared. Run pnpm install to reinstall.'",
    "commitlint": "commitlint --edit",
    "docs:lint": "pnpm --package=@redocly/cli@2.3.0 dlx redocly lint src/docs/openapi.yaml",
    "prepare": "husky",
    "standard": "pnpm standard:format && pnpm standard:lint",
    "standard:fix": "pnpm standard:format:fix && pnpm standard:lint:fix",
    "standard:format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "standard:lint": "eslint .",
    "standard:lint:fix": "eslint . --fix",
    "start": "node --env-file-if-exists=.env src/index.js",
    "start:dev": "portless run --name ingrid --lan -- node --env-file-if-exists=.env --watch-path=./src --watch-preserve-output src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml \"test/**/*.test.js\"",
    "test:integration": "OSRM_INTEGRATION=1 node --test test/integration.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "swagger-ui-dist": "5.33.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "portless": "^0.12.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "22.15.1"
  },
  "packageManager": "pnpm@10.22.0"
}
